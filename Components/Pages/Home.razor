@page "/"
@rendermode InteractiveServer
@inject ProductService ProductService
@inject NavigationManager NavigationManager

<PageTitle>Home – H-Tech Store</PageTitle>

<!-- Hero Banner -->
<div class="hero-banner">
    <div class="container text-center">
        <h1><i class="bi bi-bag-heart-fill me-3"></i>H-Tech Store</h1>
        <p class="mb-0">Discover our latest products — quality you can trust</p>
    </div>
</div>

<!-- Products Grid -->
<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <i class="bi bi-grid-3x3-gap-fill me-2 text-primary"></i>Our Products
        </h4>
        <span class="badge bg-primary rounded-pill px-3 py-2">
            @products.Count Items
        </span>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var product in products)
        {
            <div class="col">
                <div class="card product-card h-100 shadow-sm">
                    <div style="overflow:hidden;">
                        <img src="@product.ImageUrl"
                             class="card-img-top"
                             alt="@product.Name" />
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-semibold mb-1">@product.Name</h5>
                        <p class="card-text text-muted small flex-grow-1 mb-3">
                            @product.Description
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="price-badge">$@product.Price.ToString("0.00")</span>
                            <button class="btn btn-order btn-sm"
                                    @onclick="() => OrderNow(product.Id)">
                                <i class="bi bi-cart-plus me-1"></i> Order Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<Product> products = new();

    protected override void OnInitialized()
    {
        products = ProductService.GetProducts();
    }

    private void OrderNow(int productId)
    {
        NavigationManager.NavigateTo($"/orderform/{productId}");
    }
}