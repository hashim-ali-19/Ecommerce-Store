<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <HeadOutlet />

    <style>
            /* ===== GLOBAL ===== */
            body {
                font-family: 'Poppins', sans-serif;
                background-color: #f0f2f5;
            }

            /* ===== NAVBAR ===== */
            .navbar {
                padding: 14px 0;
                box-shadow: 0 2px 12px rgba(0,0,0,0.15);
            }

            .navbar-brand {
                font-size: 1.4rem;
                font-weight: 700;
                letter-spacing: 0.5px;
            }

            .nav-link {
                font-weight: 500;
                font-size: 0.95rem;
                padding: 6px 16px !important;
                border-radius: 20px;
                transition: background 0.2s;
            }

                .nav-link:hover, .nav-link.active {
                    background: rgba(255,255,255,0.15);
                }

            /* ===== HERO BANNER (Home page) ===== */
            .hero-banner {
                background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
                color: white;
                padding: 60px 0;
                margin-bottom: 40px;
                border-radius: 0 0 30px 30px;
            }

                .hero-banner h1 {
                    font-size: 2.5rem;
                    font-weight: 700;
                }

                .hero-banner p {
                    font-size: 1.1rem;
                    opacity: 0.85;
                }

            /* ===== PRODUCT CARDS ===== */
            .product-card {
                border: none !important;
                border-radius: 16px !important;
                overflow: hidden;
                transition: transform 0.3s ease, box-shadow 0.3s ease;
                background: white;
            }

                .product-card:hover {
                    transform: translateY(-8px);
                    box-shadow: 0 20px 40px rgba(0,0,0,0.12) !important;
                }

                .product-card .card-img-top {
                    height: 210px;
                    object-fit: cover;
                    transition: transform 0.4s ease;
                }

                .product-card:hover .card-img-top {
                    transform: scale(1.05);
                }

                .product-card .card-body {
                    padding: 20px;
                }

            .price-badge {
                background: linear-gradient(135deg, #11998e, #38ef7d);
                color: white;
                padding: 4px 12px;
                border-radius: 20px;
                font-weight: 600;
                font-size: 1rem;
            }

            .btn-order {
                background: linear-gradient(135deg, #667eea, #764ba2);
                border: none;
                color: white;
                border-radius: 20px;
                padding: 6px 18px;
                font-weight: 500;
                transition: opacity 0.2s, transform 0.2s;
            }

                .btn-order:hover {
                    opacity: 0.9;
                    transform: scale(1.05);
                    color: white;
                }

            /* ===== ORDER FORM ===== */
            .form-card {
                background: white;
                border-radius: 20px;
                padding: 36px;
                box-shadow: 0 8px 32px rgba(0,0,0,0.08);
            }

            .form-control, .form-select {
                border-radius: 10px;
                border: 1.5px solid #e0e0e0;
                padding: 10px 14px;
                font-size: 0.95rem;
                transition: border-color 0.2s, box-shadow 0.2s;
            }

                .form-control:focus {
                    border-color: #667eea;
                    box-shadow: 0 0 0 3px rgba(102,126,234,0.15);
                }

            .form-label {
                font-weight: 600;
                font-size: 0.9rem;
                color: #444;
                margin-bottom: 6px;
            }

            .product-info-card {
                background: linear-gradient(135deg, #f5f7fa, #c3cfe2);
                border-radius: 14px;
                padding: 16px;
                border: none;
            }

            .btn-place-order {
                background: linear-gradient(135deg, #11998e, #38ef7d);
                border: none;
                color: white;
                border-radius: 25px;
                padding: 12px 32px;
                font-weight: 600;
                font-size: 1rem;
                transition: opacity 0.2s, transform 0.2s;
            }

                .btn-place-order:hover {
                    opacity: 0.9;
                    transform: scale(1.03);
                    color: white;
                }

            /* ===== ORDER CONFIRMED ===== */
            .confirmed-card {
                background: white;
                border-radius: 20px;
                box-shadow: 0 8px 32px rgba(0,0,0,0.08);
                overflow: hidden;
            }

            .confirmed-header {
                background: linear-gradient(135deg, #11998e, #38ef7d);
                color: white;
                padding: 20px 28px;
                font-size: 1.1rem;
                font-weight: 600;
            }

            .checkmark-circle {
                width: 90px;
                height: 90px;
                background: linear-gradient(135deg, #11998e, #38ef7d);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 20px;
                font-size: 2.5rem;
            }

            .summary-table th {
                color: #888;
                font-weight: 500;
                width: 45%;
                padding: 10px 16px;
            }

            .summary-table td {
                font-weight: 600;
                color: #333;
                padding: 10px 16px;
            }

            .total-row {
                background: linear-gradient(135deg, #f0fff4, #dcfce7);
            }

                .total-row th, .total-row td {
                    color: #166534 !important;
                    font-size: 1.1rem;
                }

            .btn-home {
                background: linear-gradient(135deg, #667eea, #764ba2);
                border: none;
                color: white;
                border-radius: 25px;
                padding: 12px 36px;
                font-weight: 600;
                font-size: 1rem;
                transition: opacity 0.2s, transform 0.2s;
            }

                .btn-home:hover {
                    opacity: 0.9;
                    transform: scale(1.03);
                    color: white;
                }

            /* ===== FOOTER ===== */
            footer {
                margin-top: 60px;
                padding: 20px 0;
                font-size: 0.88rem;
                letter-spacing: 0.3px;
            }
    </style>
</head>

<body>
    <Routes />

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js">
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>